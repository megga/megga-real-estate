# Legacy FR routes → EN routes (301 SEO-preserving redirects).
# Évalués AVANT le SPA fallback, donc Cloudflare répond directement avec un 301
# sans charger l'app React. Préserve SEO + bookmarks + magic links existants.
#
# Les routes paramétrées (:splat) capturent tout segment dynamique.

# Auth
/auth/connexion                              /auth/login                       301
/auth/connexion/lien-envoye                  /auth/login/link-sent             301
/auth/connexion/erreur                       /auth/login/error                 301
/auth/inscription                            /auth/signup                      301
/auth/inscription/email-verifier             /auth/signup/verify-email         301
/auth/mot-de-passe-oublie                    /auth/forgot-password             301
/auth/mot-de-passe-oublie/envoye             /auth/forgot-password/sent        301
/auth/mot-de-passe-oublie/redefinir          /auth/forgot-password/reset       301

# Storefront
/acheter                                     /buy                              301
/louer                                       /rent                             301
/vendre                                      /sell                             301
/estimations                                 /estimates                        301
/estimer                                     /estimate                         301
/publier                                     /publish                          301
/agences                                     /agencies                         301
/acheter-legacy                              /search-legacy                    301
/louer-legacy                                /rent-legacy                      301

