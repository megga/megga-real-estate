{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "export PATH=/usr/local/bin:$PATH && npm run preview"
      ],
      "port": 4173
    },
    {
      "name": "vitrine",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-vitrine.mjs"
      ],
      "port": 4180
    }
  ]
}
