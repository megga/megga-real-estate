# ============================================================================
# MEGGA Real Estate — Variables d'environnement
# ============================================================================
# Copier ce fichier vers `.env.local` et remplir les valeurs.
# .env.local est dans .gitignore et ne doit JAMAIS être commité.
# ============================================================================

# ─── Supabase (obligatoire) ─────────────────────────────────────────────────
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://eayczugyrvmtqnnmvjod.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Mapbox (obligatoire pour SearchPage, ListingPage, VendrePage hero) ─────
# https://account.mapbox.com/access-tokens/ → créer un public token
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# ─── PostHog Analytics (optionnel) ──────────────────────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.posthog.com

# ============================================================================
# DEV-ONLY — ne JAMAIS activer en prod
# ============================================================================

# Bypass auth (utilise un profil mocké au lieu de Supabase Auth)
# Mettre à 'true' pour dev local sans credentials Supabase.
# Le code throw si DEV_BYPASS_AUTH=true ET import.meta.env.PROD=true.
VITE_DEV_BYPASS_AUTH=false

# Rôle du profil mocké quand DEV_BYPASS_AUTH=true
# Valeurs : 'agent' (défaut, le plus sûr) | 'super_admin' | 'particulier' | 'admin'
VITE_DEV_BYPASS_ROLE=agent

# Bypass le PasswordGate (écran "site en dev") — utile pour tests E2E
VITE_PASSWORD_GATE_BYPASS=false
