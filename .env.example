# ============================================================================
# MEGGA Real Estate — Variables d'environnement
# ============================================================================
# Copier ce fichier vers `.env.local` et remplir les valeurs.
# .env.local est dans .gitignore et ne doit JAMAIS être commité.
# ============================================================================

# ─── Supabase (obligatoire) ─────────────────────────────────────────────────
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://eayczugyrvmtqnnmvjod.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Origines des deux applications (optionnel — valeurs de prod par défaut) ─
# Le CRM (app.megga.ch) et la console super-admin (admin.megga.ch) sont deux
# bundles sur deux origines. Ces variables ne servent qu'à viser des serveurs
# locaux : `npm run dev` sur 5173, `npm run dev:admin` sur 5174.
VITE_ADMIN_URL=http://localhost:5174
VITE_APP_URL=http://localhost:5173

# ─── Mapbox (obligatoire pour SearchPage, ListingPage, VendrePage hero) ─────
# https://account.mapbox.com/access-tokens/ → créer un public token
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# ─── PostHog Analytics (optionnel) ──────────────────────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.posthog.com

# ─── Sentry Error Tracking (optionnel) ──────────────────────────────────────
# DSN public par design — fallback hardcodé dans src/lib/sentry.ts.
# Override ici si tu veux pointer vers un autre projet Sentry (staging, etc.).
VITE_SENTRY_DSN=
# Mettre à 'true' pour activer Sentry en dev local (sinon désactivé hors prod).
VITE_SENTRY_FORCE_DEV=false

# ─── Intercom Messenger (support unique : Messenger + Fin + Inbox) ───────────
# App ID public (région US — plan startup). Vide = widget désactivé (no-op).
# Même valeur à reporter dans sites/megga-vitrine/js/intercom.js.
# Le secret Messenger Security JWT (INTERCOM_MESSENGER_SECRET) vit côté Edge, pas ici.
VITE_INTERCOM_APP_ID=

# ============================================================================
# DEV-ONLY — ne JAMAIS activer en prod
# ============================================================================

# Bypass auth (utilise un profil mocké au lieu de Supabase Auth)
# Mettre à 'true' pour dev local sans credentials Supabase.
# Le code throw si DEV_BYPASS_AUTH=true ET import.meta.env.PROD=true.
VITE_DEV_BYPASS_AUTH=false

# Rôle du profil mocké quand DEV_BYPASS_AUTH=true
# Valeurs : 'agent' (défaut, le plus sûr) | 'super_admin' | 'particulier' | 'admin'
VITE_DEV_BYPASS_ROLE=agent

# Bypass le PasswordGate (écran "site en dev") — utile pour tests E2E
VITE_PASSWORD_GATE_BYPASS=false
