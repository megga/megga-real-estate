.env.sentry-build-plugin

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# wrangler local dev cache (transient build artifacts from `wrangler pages dev`
# used to test the storefront _worker.js locally — never committed)
.wrangler/

# ruflo / claude-flow runtime (ephemeral binaries — durable knowledge lives in
# committed exports, NOT these DBs which are machine-specific and churn)
.swarm/
ruvector.db
agentdb.rvf*
.claude/memory.db
*.db-shm
*.db-wal
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/neural/
# Daemon/session runtime state (PID, live state, active policy) — per-machine,
# regenerated each run; must never be committed.
.claude-flow/daemon-state.json
.claude-flow/daemon.pid
.claude-flow/harness-active-policy.json
.claude/proven-config.json
.claude/.proven-config-version

# Deno (edge functions checked via `deno check`, no lockfile tracked)
deno.lock
