# Backend integration tests — Vitest (tests/backend/).
# Copy to .env.test.local (gitignored) and fill from `supabase status` output.
#
# Setup (one-time):
#   1. Install Docker engine (Colima or Docker Desktop)
#   2. `supabase start` from project root → wait for 8 containers up
#   3. `supabase status` → copy the API URL, anon key, service_role key below
#   4. `npm run test:backend`
#
# These tests connect ONLY to the local Supabase (helpers/supabase.ts hard-fails
# if URL is not 127.0.0.1 / localhost). Never accidentally hits production.

SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
