{
  "name": "megga-vite-init",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/overlay-storefront.mjs",
    "lint": "eslint .",
    "lint:prose": "node scripts/check-prose-typography.mjs",
    "check:drift": "node scripts/check-migration-drift.mjs",
    "lint:i18n": "node scripts/lint-i18n-hardcoded.mjs",
    "lint:deadcode": "node scripts/check-dead-exports.mjs",
    "i18n:prose:fix": "node scripts/i18n-fix-typography.mjs",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "i18n:parity": "node scripts/i18n-parity.mjs",
    "i18n:parity:ci": "node scripts/i18n-parity.mjs --ci",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:backend": "vitest run --config=vitest.backend.config.ts",
    "test:eval": "vitest run --config=vitest.backend.config.ts tests/backend/whatsapp-comprehension-golden.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "test:e2e:kyb": "playwright test --config=playwright.kyb.config.ts",
    "ruflo:seed": "node scripts/ruflo-seed-memory.mjs",
    "lint:roster": "node scripts/check-edge-roster.mjs",
    "lint:migrations": "node scripts/check-migration-idempotence.mjs",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@intercom/messenger-js-sdk": "^0.0.19",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@sentry/react": "^10.53.1",
    "@supabase-cache-helpers/postgrest-react-query": "^1.13.9",
    "@supabase/supabase-js": "^2.99.2",
    "@tanstack/react-query": "^5.90.21",
    "autoprefixer": "^10.4.27",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "i18next": "^25.10.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "mapbox-gl": "^3.20.0",
    "motion": "^12.38.0",
    "postcss": "^8.5.8",
    "posthog-js": "^1.363.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^16.6.0",
    "react-map-gl": "^8.1.0",
    "react-router-dom": "^6.30.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/ui": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "postcss-selector-parser": "^7.1.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-prune": "^0.10.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.7"
  }
}
